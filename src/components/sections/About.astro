---
import { site } from "../../lib/site";
import ScrollFade from "../ScrollFade.astro";
const { about } = site;
---
<section id="about-alt" class="about">
  <div class="about-stage">
    <div class="about-content">
      <div class="about-bio-row container">
        <div class="about-bio-meta">
          <p class="body muted">About</p>
        </div>
        <div class="about-bio-col">
          <ScrollFade>
            <div class="about-profile">
              <h2 class="h2 balance about-headline">게임을 즐기며 실력을 키워<br /><span>프로게이머를 꿈꿉니다.</span></h2>
              <p class="body balance">{about.description}</p>
              <dl class="about-facts">
                {about.facts.map((fact) => (
                  <div class="about-fact">
                    <dt class="caption muted">{fact.label}</dt>
                    <dd class="body">{fact.value}</dd>
                  </div>
                ))}
                {site.tmi.map((item) => (
                  <div class="about-fact">
                    <dt class="caption muted">{item.label}</dt>
                    <dd class="body">{item.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </ScrollFade>
        </div>
      </div>
    </div>
  </div>
</section>
