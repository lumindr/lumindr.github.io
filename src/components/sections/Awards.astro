---
import { site } from "../../lib/site";
import ScrollWords from "../ScrollWords.astro";
---
<section class="tmi container">
  <ScrollWords as="h2" class="h2 balance tmi-heading" text="나에 대한 TMI" />
  <div class="tmi-grid">
    {site.tmi.map((item) => (
      <article class="tmi-card">
        <p class="body muted">{item.label}</p>
        <h3 class="h4 balance">{item.value}</h3>
      </article>
    ))}
  </div>
</section>
