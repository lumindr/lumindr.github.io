---
import { site } from "../../lib/site";
import ScrollWords from "../ScrollWords.astro";
const { contact } = site;
---
<section id="contact" class="contact container">
  <div class="contact-main">
    <div class="contact-left">
      <ScrollWords as="h2" class="h2 balance" text={contact.heading} />
    </div>
    <div class="contact-right">
      <p class="body-sb" style="color: var(--grey)">{contact.label}</p>
      <p class="body balance">{contact.text}</p>
    </div>
    <div class="contact-email-card">
      <span class="contact-email-label"><span class="contact-mail-icon" aria-hidden="true">✉</span> EMAIL</span>
      <button class="contact-copy-icon" type="button" data-copy-email={site.email} aria-label="이메일 복사">
        <svg class="copy-state-icon" data-copy-icon viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="10" y="4" width="18" height="21" rx="3" stroke="currentColor" stroke-width="2.4"/><rect x="4" y="10" width="18" height="19" rx="3" stroke="currentColor" stroke-width="2.4"/></svg>
        <svg class="copy-state-icon is-hidden" data-copied-icon viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="m6 16 7 7L27 8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <strong class="contact-email-address">{site.email}</strong>
    </div>
  </div>
</section>
