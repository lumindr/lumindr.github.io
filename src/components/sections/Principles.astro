---
import { site } from "../../lib/site";
import ScrollWords from "../ScrollWords.astro";
import Icon from "../Icon.astro";
---
<section class="games container">
  <div class="games-header">
    <ScrollWords as="h2" class="h3 balance games-heading" text="그동안 만든 작품들" />
  </div>
  <div class="games-grid">
    {site.games.map((game) => (
      <article class="game-card">
        <div class="game-card-media">
          <img src={game.image} alt={game.alt} loading="lazy" />
        </div>
        <div class="game-card-content">
          <div class="game-card-heading">
            <h3>{game.title}</h3>
          </div>
          <p class="game-description">{game.description}</p>
          <div class="game-actions">
            <a class="game-action game-action-primary" href={game.gameUrl} target="_blank" rel="noopener noreferrer">
              <span>게임 플레이</span>
              <Icon name="arrow-up-right" size={20} />
            </a>
            <a class="game-action game-action-secondary" href={game.detailsUrl} target="_blank" rel="noopener noreferrer">
              <span>자세한 설명 보기</span>
              <Icon name="arrow-up-right" size={20} />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
